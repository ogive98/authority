# AUTHORITY — copy to .env (never commit .env)

NODE_ENV=development

# API (NestJS)
API_PORT=3001

# Web (Next.js)
WEB_PORT=3000

# PostgreSQL (SOC-02+)
DATABASE_URL=postgresql://authority:authority@localhost:5432/authority

# Redis (Thunder / BullMQ — SOC-02+)
REDIS_URL=redis://localhost:6379

# MinIO / S3-compatible (SOC-02+)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=authority
MINIO_SECRET_KEY=authoritydev
MINIO_BUCKET=authority
MINIO_USE_SSL=false
