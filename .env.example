# AUTHORITY — copy to .env (never commit .env)

NODE_ENV=development
AUTHORITY_ENV=development

# API (NestJS) — si EADDRINUSE : npm run stop:api -w api
API_PORT=3001

# Web (Next.js)
WEB_PORT=3000

# PostgreSQL (SOC-02+)
# Profil Docker (recommandé si PG local occupe 5432) :
DATABASE_URL=postgresql://authority:authority@localhost:5433/authority
# Profil PostgreSQL local (adapter user/mot de passe) :
# DATABASE_URL=postgresql://postgres:TON_MDP@localhost:5432/authority

# Redis (Thunder / BullMQ — SOC-02+)
REDIS_URL=redis://localhost:6379

# MinIO / S3-compatible (SOC-02+)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=authority
MINIO_SECRET_KEY=authoritydev
MINIO_BUCKET=authority
MINIO_USE_SSL=false

# Upload max size (MB) — SOC-09 files
MAX_UPLOAD_MB=10

# Super Admin (SOC-05) — AES-256 key for TOTP secrets (64 hex chars). Rotate in production.
AUTHORITY_MFA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Non-prod only. Production always enforces Super Admin TOTP.
AUTHORITY_SUPER_ADMIN_MFA_ENFORCED=false
