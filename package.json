{
  "name": "authority",
  "version": "0.1.0",
  "private": true,
  "description": "AUTHORITY ERP — modular industrial monolith",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w api && npm run build -w web",
    "lint": "npm run lint -w api && npm run lint -w web",
    "typecheck": "npm run typecheck -w api && npm run typecheck -w web",
    "test": "npm run test -w api",
    "test:e2e": "npm run test:e2e -w api",
    "test:all": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:e2e",
    "dev:api": "npm run start:dev -w api",
    "dev:web": "npm run dev -w web",
    "db:migrate": "npm run prisma:migrate -w api",
    "db:seed": "npm run prisma:seed -w api",
    "db:deploy": "npm run prisma:deploy -w api",
    "verify:soc08": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-soc08-patch.ps1",
    "verify:soc10": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-soc10-license.ps1"
  },
  "engines": {
    "node": ">=20"
  }
}
