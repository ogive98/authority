    {
      "name": "Settings (SOC-11)",
      "item": [
        {
          "name": "0 — Effective (apres Login + Set context)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.environment.get('companyId')) {",
                  "  throw new Error('companyId vide : faites Organization 0 puis 1 avant');",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Settings effective OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.test('Has ui.theme', function () {",
                  "    pm.expect(body.settings.some(function (s) { return s.key === 'ui.theme'; })).to.be.true;",
                  "  });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/settings/effective"
          }
        },
        {
          "name": "1 — Update theme (USER)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.environment.get('companyId')) {",
                  "  throw new Error('companyId vide : faites Organization 0 puis 1 avant');",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Theme updated', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.test('Source is USER', function () {",
                  "    pm.expect(body.source).to.eql('USER');",
                  "  });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"ui.theme\",\n  \"value\": \"dark\",\n  \"level\": \"USER\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/settings"
          }
        },
        {
          "name": "2 — Pref ne donne pas permission admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('identity.user.manage denied', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().allowed).to.eql(false);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"permissionKey\": \"identity.user.manage\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/identity/permissions/check"
          }
        }
      ]
    },
