{
  "info": {
    "_postman_id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
    "name": "AUTHORITY API",
    "description": "Collection AUTHORITY — importer avec l'environnement `AUTHORITY — Local`.\n\n**Ordre recommandé (Collection Runner) :**\n1. Health → Live\n2. Identity → Login\n3. Identity → Me\n4. Organization → List companies\n5. Organization → Set context\n6. Organization → List sites\n\nLes cookies de session sont gérés automatiquement par Postman après le Login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Live",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health/live"
          }
        },
        {
          "name": "Ready",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health/ready"
          }
        }
      ]
    },
    {
      "name": "Identity",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('sessionId', body.session.id);",
                  "  pm.collectionVariables.set('sessionId', body.session.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/identity/auth/login"
          }
        },
        {
          "name": "Me",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Authenticated', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/identity/me"
          }
        },
        {
          "name": "Revoke session",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/v1/identity/sessions/{{sessionId}}"
          }
        }
      ]
    },
    {
      "name": "Organization",
      "item": [
        {
          "name": "List companies",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Companies listed', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const companies = pm.response.json();",
                  "  const demo = companies.find(function (c) { return c.code === 'DEMO'; });",
                  "  if (demo) {",
                  "    pm.environment.set('companyId', demo.id);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/organization/companies"
          }
        },
        {
          "name": "Set context",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyId\": \"{{companyId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/organization/me/context"
          }
        },
        {
          "name": "Get context",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/organization/me/context"
          }
        },
        {
          "name": "Get company DEMO",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/organization/companies/{{companyId}}"
          }
        },
        {
          "name": "List sites",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Sites listed', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const sites = pm.response.json();",
                  "  if (sites.length > 0) {",
                  "    pm.environment.set('siteId', sites[0].id);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/organization/companies/{{companyId}}/sites"
          }
        },
        {
          "name": "IDOR — other company (expect 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('IDOR blocked', function () {",
                  "  pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/organization/companies/00000000-0000-4000-8000-000000000099"
          }
        }
      ]
    },
    {
      "name": "Super Admin",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('SA login OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{superAdminEmail}}\",\n  \"password\": \"{{superAdminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/super-admin/v1/auth/login"
          }
        },
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('SA health OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/super-admin/v1/health"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001"
    },
    {
      "key": "sessionId",
      "value": ""
    }
  ]
}
