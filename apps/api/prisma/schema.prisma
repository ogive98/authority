generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- core_* platform kernel ---

model CoreOutbox {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String?   @map("company_id") @db.Uuid
  aggregateType   String    @map("aggregate_type")
  aggregateId     String    @map("aggregate_id") @db.Uuid
  eventType       String    @map("event_type")
  eventVersion    Int       @default(1) @map("event_version")
  payloadJson     Json      @map("payload_json")
  headers         Json?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(6)
  publishAttempts Int       @default(0) @map("publish_attempts")

  @@index([companyId, createdAt(sort: Desc)])
  @@index([publishedAt])
  @@map("core_outbox")
}

model CoreOutboxDlq {
  id              String   @id @default(uuid()) @db.Uuid
  outboxId        String   @map("outbox_id") @db.Uuid
  companyId       String?  @map("company_id") @db.Uuid
  aggregateType   String   @map("aggregate_type")
  aggregateId     String   @map("aggregate_id") @db.Uuid
  eventType       String   @map("event_type")
  eventVersion    Int      @map("event_version")
  payloadJson     Json     @map("payload_json")
  headers         Json?
  lastError       String   @map("last_error")
  publishAttempts Int      @map("publish_attempts")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  failedAt        DateTime @default(now()) @map("failed_at") @db.Timestamptz(6)

  @@index([companyId, failedAt(sort: Desc)])
  @@index([outboxId])
  @@index([eventType])
  @@map("core_outbox_dlq")
}

model CoreProcessedEvent {
  id          String   @id @default(uuid()) @db.Uuid
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@unique([consumer, eventId])
  @@map("core_processed_event")
}

model CoreNumberingSeries {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  siteId    String?   @map("site_id") @db.Uuid
  docType   String    @map("doc_type")
  year      Int
  prefix    String
  nextValue Int       @default(1) @map("next_value")
  padding   Int       @default(6)
  version   Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([companyId, siteId, docType, year])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("core_numbering_series")
}

model CoreFile {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  bucket     String
  key        String
  mime       String
  size       BigInt
  checksum   String?
  virusScan  String?   @map("virus_scan")
  version    Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([companyId, createdAt(sort: Desc)])
  @@map("core_file")
}

model CoreSearchIndex {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  content    String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([companyId, entityType])
  @@map("core_search_index")
}

// --- iam_* identity kernel ---

enum IamUserStatus {
  INVITED
  ACTIVE
  LOCKED
  DISABLED
}

enum IamLifecycleStatus {
  ACTIVE
  REVOKED
}

enum IamSessionRealm {
  BUSINESS
  SUPER_ADMIN
}

enum IamMfaPurpose {
  BUSINESS
  SUPER_ADMIN
}

model IamUser {
  id          String        @id @default(uuid()) @db.Uuid
  email       String        @unique
  displayName String        @map("display_name")
  status      IamUserStatus @default(INVITED)
  locale      String        @default("fr-TN")
  timezone    String        @default("Africa/Tunis")
  mfaEnabled  Boolean       @default(false) @map("mfa_enabled")
  passwordHash String?      @map("password_hash")
  version     Int           @default(0)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(6)

  sessions               IamSession[]
  mfaDevices             IamMfaDevice[]
  devices                IamDevice[]
  loginAttempts          IamLoginAttempt[]
  assignments            OrgUserAssignment[]
  superAdminMembership   IamSuperAdminMembership?

  @@map("iam_user")
}

model IamSession {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  env         String
  ip          String?
  userAgent   String?            @map("user_agent")
  expiresAt   DateTime           @map("expires_at") @db.Timestamptz(6)
  refreshHash String?            @map("refresh_hash")
  realm       IamSessionRealm    @default(BUSINESS)
  status      IamLifecycleStatus @default(ACTIVE)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  user IamUser @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([refreshHash])
  @@map("iam_session")
}

model IamMfaDevice {
  id         String             @id @default(uuid()) @db.Uuid
  userId     String             @map("user_id") @db.Uuid
  purpose    IamMfaPurpose      @default(BUSINESS)
  secretEnc  String             @map("secret_enc")
  lastUsedAt DateTime?          @map("last_used_at") @db.Timestamptz(6)
  status     IamLifecycleStatus @default(ACTIVE)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  user IamUser @relation(fields: [userId], references: [id])

  @@index([userId, purpose])
  @@map("iam_mfa_device")
}

model IamSuperAdminMembership {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @unique @map("user_id") @db.Uuid
  status    IamLifecycleStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  user IamUser @relation(fields: [userId], references: [id])

  @@map("iam_super_admin_membership")
}

model IamDevice {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  name      String?
  fingerprint String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user IamUser @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("iam_device")
}

model IamLoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  email     String?
  ip        String?
  success   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user IamUser? @relation(fields: [userId], references: [id])

  @@index([email, createdAt(sort: Desc)])
  @@map("iam_login_attempt")
}

enum IamGrantEffect {
  ALLOW
  DENY
}

enum IamGrantSubject {
  USER
  ROLE
}

model IamGrant {
  id            String             @id @default(uuid()) @db.Uuid
  permissionKey String             @map("permission_key")
  effect        IamGrantEffect     @default(ALLOW)
  subjectType   IamGrantSubject    @map("subject_type")
  subjectId     String             @map("subject_id")
  companyId     String?            @map("company_id") @db.Uuid
  siteId        String?            @map("site_id") @db.Uuid
  warehouseId   String?            @map("warehouse_id") @db.Uuid
  status        IamLifecycleStatus @default(ACTIVE)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([subjectType, subjectId, permissionKey])
  @@index([companyId, permissionKey])
  @@map("iam_grant")
}

// --- org_* organization kernel ---

enum OrgCompanyStatus {
  ACTIVE
  SUSPENDED
}

enum OrgSiteType {
  USINE
  DEPOT
  BUREAU
}

enum OrgWarehouseType {
  FROID
  SEC
  QUAI
}

model OrgCompany {
  id        String           @id @default(uuid()) @db.Uuid
  code      String           @unique
  legalName String           @map("legal_name")
  country   String           @default("TN")
  currency  String           @default("TND")
  timezone  String           @default("Africa/Tunis")
  vatNumber String?          @map("vat_number")
  status    OrgCompanyStatus @default(ACTIVE)
  version   Int              @default(0)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?        @map("deleted_at") @db.Timestamptz(6)

  sites       OrgSite[]
  assignments OrgUserAssignment[]

  @@map("org_company")
}

model OrgSite {
  id        String         @id @default(uuid()) @db.Uuid
  companyId String         @map("company_id") @db.Uuid
  code      String
  type      OrgSiteType
  timezone  String         @default("Africa/Tunis")
  status    OrgCompanyStatus @default(ACTIVE)
  version   Int            @default(0)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?      @map("deleted_at") @db.Timestamptz(6)

  company    OrgCompany    @relation(fields: [companyId], references: [id])
  warehouses OrgWarehouse[]

  @@unique([companyId, code])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("org_site")
}

model OrgWarehouse {
  id         String           @id @default(uuid()) @db.Uuid
  companyId  String           @map("company_id") @db.Uuid
  siteId     String           @map("site_id") @db.Uuid
  code       String
  type       OrgWarehouseType
  tempMinMax String?          @map("temp_min_max")
  status     OrgCompanyStatus @default(ACTIVE)
  version    Int              @default(0)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime?        @map("deleted_at") @db.Timestamptz(6)

  site OrgSite @relation(fields: [siteId], references: [id])

  @@unique([companyId, code])
  @@index([companyId, siteId])
  @@map("org_warehouse")
}

model OrgDepartment {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  code      String
  name      String
  version   Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([companyId, code])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("org_department")
}

model OrgTeam {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  departmentId String?   @map("department_id") @db.Uuid
  code         String
  name         String
  version      Int       @default(0)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([companyId, code])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("org_team")
}

model OrgUserAssignment {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  siteId    String?   @map("site_id") @db.Uuid
  roleCode  String?   @map("role_code")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  company OrgCompany @relation(fields: [companyId], references: [id])
  user    IamUser    @relation(fields: [userId], references: [id])

  @@unique([companyId, userId])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("org_user_assignment")
}

// --- mod_* module registry ---

enum ModModuleStatus {
  ENABLED
  DISABLED
}

model ModModuleState {
  id        String          @id @default(uuid()) @db.Uuid
  companyId String          @map("company_id") @db.Uuid
  moduleKey String          @map("module_key")
  status    ModModuleStatus @default(DISABLED)
  version   Int             @default(0)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([companyId, moduleKey])
  @@index([companyId])
  @@map("mod_module_state")
}

model ModFlag {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  flagKey   String   @map("flag_key")
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([companyId, flagKey])
  @@index([companyId])
  @@map("mod_flag")
}

// --- set_* settings hierarchy (SOC-11) ---

enum SetLevel {
  SYSTEM
  COMPANY
  ROLE
  USER
}

model SetDef {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  valueType   String   @map("value_type")
  defaultJson Json     @map("default_json")
  description String?
  isPrefOnly  Boolean  @default(true) @map("is_pref_only")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  values SetValue[]

  @@map("set_def")
}

model SetValue {
  id        String    @id @default(uuid()) @db.Uuid
  defKey    String    @map("def_key")
  level     SetLevel
  scopeKey  String    @map("scope_key")
  companyId String?   @map("company_id") @db.Uuid
  valueJson Json      @map("value_json")
  version   Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  def SetDef @relation(fields: [defKey], references: [key])

  @@unique([defKey, scopeKey])
  @@index([companyId, level])
  @@map("set_value")
}

// --- aud_* immutable audit ---

model AudEvent {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String?  @map("company_id") @db.Uuid
  siteId        String?  @map("site_id") @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  action        String
  entityType    String?  @map("entity_type")
  entityId      String?  @map("entity_id") @db.Uuid
  beforeJson    Json?    @map("before_json")
  afterJson     Json?    @map("after_json")
  ip            String?
  device        String?
  correlationId String?  @map("correlation_id")
  mode          String?
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([companyId, occurredAt(sort: Desc)])
  @@map("aud_event")
}

// --- lic_* hybrid license stub (SOC-10) ---

model LicCurrent {
  id           String    @id @default(uuid()) @db.Uuid
  payloadJson  Json      @map("payload_json")
  signature    String
  cachedUntil  DateTime? @map("cached_until") @db.Timestamptz(6)
  lastOnlineAt DateTime? @map("last_online_at") @db.Timestamptz(6)
  version      Int       @default(0)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("lic_current")
}

model LicHistory {
  id          String   @id @default(uuid()) @db.Uuid
  payloadJson Json     @map("payload_json")
  signature   String
  activatedAt DateTime @default(now()) @map("activated_at") @db.Timestamptz(6)

  @@index([activatedAt(sort: Desc)])
  @@map("lic_history")
}

// --- thunder_* orchestration stubs ---

enum ThunderJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  PAUSED_BY_MODULE
}

enum ThunderWorkflowStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model ThunderJob {
  id             String           @id @default(uuid()) @db.Uuid
  companyId      String?          @map("company_id") @db.Uuid
  jobType        String           @map("job_type")
  queue          String           @default("ops")
  priority       Int              @default(2)
  idempotencyKey String?          @map("idempotency_key")
  payloadHash    String?          @map("payload_hash")
  payloadRef     String?          @map("payload_ref")
  payloadJson    Json?            @map("payload_json")
  resultJson     Json?            @map("result_json")
  errorJson      Json?            @map("error_json")
  bullJobId      String?          @map("bull_job_id")
  status         ThunderJobStatus @default(PENDING)
  attempts       Int              @default(0)
  scheduledAt    DateTime?        @map("scheduled_at") @db.Timestamptz(6)
  startedAt      DateTime?        @map("started_at") @db.Timestamptz(6)
  heartbeatAt    DateTime?        @map("heartbeat_at") @db.Timestamptz(6)
  finishedAt     DateTime?        @map("finished_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([companyId, idempotencyKey])
  @@index([companyId, status, createdAt(sort: Desc)])
  @@map("thunder_job")
}

model ThunderWorkflowInstance {
  id           String                @id @default(uuid()) @db.Uuid
  companyId    String                @map("company_id") @db.Uuid
  definitionId String                @map("definition_id")
  version      Int                   @default(1)
  status       ThunderWorkflowStatus @default(PENDING)
  cursorStep   String?               @map("cursor_step")
  dataJson     Json?                 @map("data_json")
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([companyId, status, createdAt(sort: Desc)])
  @@map("thunder_workflow_instance")
}

model ThunderDlqEntry {
  id          String   @id @default(uuid()) @db.Uuid
  jobId       String   @map("job_id") @db.Uuid
  companyId   String?  @map("company_id") @db.Uuid
  jobType     String   @map("job_type")
  queue       String
  payloadJson Json     @map("payload_json")
  lastError   String   @map("last_error")
  attempts    Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([companyId, createdAt(sort: Desc)])
  @@index([jobId])
  @@map("thunder_dlq")
}

model ThunderRuleDef {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String?  @map("company_id") @db.Uuid
  moduleKey       String   @map("module_key")
  name            String
  enabled         Boolean  @default(true)
  priority        Int      @default(100)
  eventPattern    String   @map("event_pattern")
  conditionsJson  Json     @map("conditions_json")
  actionsJson     Json     @map("actions_json")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([enabled, priority])
  @@index([companyId, moduleKey])
  @@index([eventPattern])
  @@map("thunder_rule_def")
}

// --- prd_* products catalogue (MOD-PRODUCTS V0 + POLY-01) ---

enum PrdProductStatus {
  DRAFT
  ACTIVE
  OBSOLETE
}

model PrdProduct {
  id              String           @id @default(uuid()) @db.Uuid
  companyId       String           @map("company_id") @db.Uuid
  sku             String
  name            String
  typeKey         String           @map("type_key")
  uom             String
  trackLot        Boolean          @default(false) @map("track_lot")
  perishable      Boolean          @default(false)
  storageClassKey String           @map("storage_class_key")
  allergenFlags   Json             @default("[]") @map("allergen_flags")
  status          PrdProductStatus @default(DRAFT)
  version         Int              @default(0)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(6)

  @@unique([companyId, sku])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, status])
  @@map("prd_product")
}

// --- md_* master data reference lists (POLY-01) ---

enum MdRefKind {
  product_type
  uom
  storage_class
  allergen
}

model MdRefValue {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  kind      MdRefKind
  code      String
  label     String
  sort      Int       @default(0)
  enabled   Boolean   @default(true)
  metaJson  Json      @default("{}") @map("meta_json")
  version   Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([companyId, kind, code])
  @@index([companyId, kind, enabled])
  @@map("md_ref_value")
}

// --- md_party kernel (Customers V1a) ---

enum MdPartyType {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum MdPartyStatus {
  ACTIVE
  BLOCKED
}

model MdParty {
  id          String        @id @default(uuid()) @db.Uuid
  companyId   String        @map("company_id") @db.Uuid
  type        MdPartyType
  legalName   String        @map("legal_name")
  taxId       String?       @map("tax_id")
  defaultLang String?       @map("default_lang")
  status      MdPartyStatus @default(ACTIVE)
  version     Int           @default(0)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(6)

  customers CusCustomer[]

  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, type, status])
  @@index([companyId, legalName])
  @@map("md_party")
}

// --- cus_* Customers V1a ---

enum CusCustomerStatus {
  ACTIVE
  INACTIVE
}

model CusCustomer {
  id           String            @id @default(uuid()) @db.Uuid
  companyId    String            @map("company_id") @db.Uuid
  partyId      String            @map("party_id") @db.Uuid
  code         String
  nickname     String?           @map("nickname")
  salesRep     String?           @map("sales_rep")
  paymentTerms String?           @map("payment_terms")
  status       CusCustomerStatus @default(ACTIVE)
  version      Int               @default(0)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?         @map("deleted_at") @db.Timestamptz(6)

  party    MdParty      @relation(fields: [partyId], references: [id])
  contacts CusContact[]

  @@unique([companyId, code])
  @@unique([companyId, partyId])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, status])
  @@index([companyId, nickname])
  @@map("cus_customer")
}

model CusContact {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  name       String
  phone      String?
  whatsapp   String?
  email      String?
  role       String?
  active     Boolean   @default(true)
  version    Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  customer CusCustomer @relation(fields: [customerId], references: [id])

  @@index([companyId, customerId, createdAt(sort: Desc)])
  @@map("cus_contact")
}

// --- inv_* Inventory light (MOD-INVENTORY) ---

enum InvMovementType {
  ADJUST
  RESERVE
  RELEASE
}

model InvWarehouse {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  code      String
  name      String
  active    Boolean   @default(true)
  version   Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  balances InvBalance[]

  @@unique([companyId, code])
  @@index([companyId, active])
  @@map("inv_warehouse")
}

model InvBalance {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  onHand      Decimal  @default(0) @map("on_hand") @db.Decimal(18, 3)
  reserved    Decimal  @default(0) @db.Decimal(18, 3)
  version     Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  warehouse InvWarehouse  @relation(fields: [warehouseId], references: [id])
  movements InvMovement[]

  @@unique([companyId, warehouseId, productId])
  @@index([companyId, productId])
  @@index([companyId, warehouseId])
  @@map("inv_balance")
}

model InvMovement {
  id            String          @id @default(uuid()) @db.Uuid
  companyId     String          @map("company_id") @db.Uuid
  balanceId     String          @map("balance_id") @db.Uuid
  type          InvMovementType
  qty           Decimal         @db.Decimal(18, 3)
  onHandAfter   Decimal         @map("on_hand_after") @db.Decimal(18, 3)
  reservedAfter Decimal         @map("reserved_after") @db.Decimal(18, 3)
  reason        String?
  refType       String?         @map("ref_type")
  refId         String?         @map("ref_id")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  balance InvBalance @relation(fields: [balanceId], references: [id])

  @@index([companyId, balanceId, createdAt(sort: Desc)])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("inv_movement")
}

// --- sa_* Super Admin industry packs (POLY-01) ---

model SaIndustryPack {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  version     Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  items SaIndustryPackItem[]

  @@map("sa_industry_pack")
}

model SaIndustryPackItem {
  id        String    @id @default(uuid()) @db.Uuid
  packId    String    @map("pack_id") @db.Uuid
  kind      MdRefKind
  code      String
  label     String
  sort      Int       @default(0)
  metaJson  Json      @default("{}") @map("meta_json")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  pack SaIndustryPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@unique([packId, kind, code])
  @@index([packId, kind])
  @@map("sa_industry_pack_item")
}

// --- sal_* Sales Order V0 ---

enum SalOrderStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model SalOrder {
  id            String         @id @default(uuid()) @db.Uuid
  companyId     String         @map("company_id") @db.Uuid
  number        String
  customerId    String         @map("customer_id") @db.Uuid
  warehouseId   String         @map("warehouse_id") @db.Uuid
  status        SalOrderStatus @default(DRAFT)
  requestedDate DateTime?      @map("requested_date") @db.Date
  currency      String         @default("TND")
  notes         String?
  /** Intake preference — real driver assignment lives in Delivery (11). */
  preferredDriver String?      @map("preferred_driver")
  amountTotal   Decimal        @default(0) @map("amount_total") @db.Decimal(18, 3)
  version       Int            @default(0)
  confirmedAt   DateTime?      @map("confirmed_at") @db.Timestamptz(6)
  cancelledAt   DateTime?      @map("cancelled_at") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?      @map("deleted_at") @db.Timestamptz(6)

  lines SalOrderLine[]

  @@unique([companyId, number])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@map("sal_order")
}

model SalOrderLine {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  lineNo      Int      @map("line_no")
  productId   String   @map("product_id") @db.Uuid
  qty         Decimal  @db.Decimal(18, 3)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(18, 3)
  discountPct Decimal  @default(0) @map("discount_pct") @db.Decimal(5, 2)
  lineTotal   Decimal  @map("line_total") @db.Decimal(18, 3)
  version     Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  order SalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, lineNo])
  @@index([companyId, orderId])
  @@map("sal_order_line")
}
