  lineTotal    Decimal  @map("line_total") @db.Decimal(18, 3)
  /** Qty actually delivered on terminal shipment complete (D175). */
  deliveredQty Decimal? @map("delivered_qty") @db.Decimal(18, 3)
  version      Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  order SalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, lineNo])
  @@index([companyId, orderId])
  @@map("sal_order_line")
}

// --- dlv_* Delivery light ---

enum DlvShipmentStatus {
  READY
  ASSIGNED
  OUT
  DELIVERED
  FAILED
}

enum DlvRoundStatus {
  PLANNED
