  movements    InvMovement[]
  allocations  InvLotAllocation[]

  @@unique([companyId, warehouseId, productId, lotCode])
  @@index([companyId, productId])
  @@index([companyId, warehouseId])
  @@index([companyId, status, dlc])
  @@map("inv_lot")
}

