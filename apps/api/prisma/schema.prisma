// --- tax_* Tax Engine (D088 VAT + D259 rule engine) — never invent rates ---
// Prefs (D090) remain the seat for FODEC/timbre/RAS/TEJ values until VALIDATED.
// CNSS / IRPP stay in HR — not TaxKind on sales documents.

enum TaxKind {
  VAT
  WITHHOLDING
  SPECIFIC_TAX
  DUTY
  CONTRIBUTION
  EXEMPTION
  DEDUCTION
  OTHER
}

enum TaxCalcMethod {
  RATE
  FIXED
  QTY
}

/** DRAFT → PENDING_EXPERT → VALIDATED → ACTIVE. Sensitive rules must not skip expert. */
enum TaxRuleStatus {
  DRAFT
  PENDING_EXPERT
  VALIDATED
  ACTIVE
  INACTIVE
}

enum TaxDecisionSource {
  SYSTEM_RULE
  CLIENT_OVERRIDE
  EXEMPTION
  MANUAL_OVERRIDE
}

model TaxCode {
  id                 String         @id @default(uuid()) @db.Uuid
  companyId          String         @map("company_id") @db.Uuid
  code               String
  label              String
  kind               TaxKind        @default(VAT)
  calcMethod         TaxCalcMethod  @default(RATE) @map("calc_method")
  /** New non-VAT rules default DRAFT; existing VAT backfilled ACTIVE (D259). */
  status             TaxRuleStatus  @default(DRAFT)
  active             Boolean        @default(true)
  unit               String?
  currency           String         @default("TND")
  description        String?
  priority           Int            @default(0)
  lawRef             String?        @map("law_ref")
  validatedBy        String?        @map("validated_by") @db.Uuid
  validatedAt        DateTime?      @map("validated_at") @db.Timestamptz(6)
  validationComment  String?        @map("validation_comment")
  version            Int            @default(0)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?      @map("deleted_at") @db.Timestamptz(6)

  rates           TaxRate[]
  invoiceLines    FinInvoiceLine[]
  creditNoteLines FinCreditNoteLine[]
  apBillLines     FinApBillLine[]
  taxLines        TaxLine[]
  customerOverrides CusFiscalRuleOverride[]
  productOverrides  PrdFiscalRuleOverride[]
  defaultForProducts PrdFiscalProfile[] @relation("PrdFiscalDefaultVat")

  @@unique([companyId, code])
  @@index([companyId, kind, active])
  @@index([companyId, status, kind])
  @@map("tax_code")
}

model TaxRate {
  id                 String         @id @default(uuid()) @db.Uuid
  companyId          String         @map("company_id") @db.Uuid
  taxCodeId          String         @map("tax_code_id") @db.Uuid
  calcMethod         TaxCalcMethod  @default(RATE) @map("calc_method")
  /** Basis points: 1900 = 19%. 0 when method is FIXED/QTY. */
  rateBps            Int            @map("rate_bps")
  /** FIXED = per document; QTY = per unit. Millimes (1000 = 1 TND). Null until expert. */
  amountMilli        Int?           @map("amount_milli")
  unit               String?
  currency           String         @default("TND")
  status             TaxRuleStatus  @default(VALIDATED)
  validFrom          DateTime       @map("valid_from") @db.Date
  validTo            DateTime?      @map("valid_to") @db.Date
  lawRef             String?        @map("law_ref")
  expertValidatedAt  DateTime?      @map("expert_validated_at") @db.Timestamptz(6)
  validatedBy        String?        @map("validated_by") @db.Uuid
  validationComment  String?        @map("validation_comment")
  version            Int            @default(0)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?      @map("deleted_at") @db.Timestamptz(6)

  taxCode  TaxCode   @relation(fields: [taxCodeId], references: [id], onDelete: Cascade)
  taxLines TaxLine[]

  @@index([companyId, taxCodeId, validFrom])
  @@index([companyId, validFrom])
  @@index([companyId, status])
  @@map("tax_rate")
}

/**
 * Immutable fiscal snapshot (CDC tax_line). Preview calculate does not persist.
 * Frozen rows must never be recalculated when a later rate changes.
 */
model TaxLine {
  id                String             @id @default(uuid()) @db.Uuid
  companyId         String             @map("company_id") @db.Uuid
  sourceType        String             @map("source_type")
  sourceId          String?            @map("source_id") @db.Uuid
  lineNo            Int?               @map("line_no")
  taxCodeId         String             @map("tax_code_id") @db.Uuid
  taxRateId         String?            @map("tax_rate_id") @db.Uuid
  ruleVersion       Int                @map("rule_version")
  taxCode           String             @map("tax_code")
  taxName           String             @map("tax_name")
  kind              TaxKind
  calcMethod        TaxCalcMethod      @map("calc_method")
  rateBps           Int?               @map("rate_bps")
  amountMilli       Int?               @map("amount_milli")
  base              Decimal            @db.Decimal(18, 3)
  taxableQuantity   Decimal?           @map("taxable_quantity") @db.Decimal(18, 3)
  unit              String?
  calculatedAmount  Decimal            @map("calculated_amount") @db.Decimal(18, 3)
  currency          String             @default("TND")
  applicable        Boolean            @default(true)
  reason            String
  source            TaxDecisionSource  @default(SYSTEM_RULE)
  lawRef            String?            @map("law_ref")
  effectiveFrom     DateTime           @map("effective_from") @db.Date
  effectiveTo       DateTime?          @map("effective_to") @db.Date
  calculatedAt      DateTime           @map("calculated_at") @db.Timestamptz(6)
  frozen            Boolean            @default(false)
  version           Int                @default(0)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?          @map("deleted_at") @db.Timestamptz(6)

  taxCodeRel      TaxCode             @relation(fields: [taxCodeId], references: [id])
  taxRate         TaxRate?            @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  invoiceLines    FinInvoiceLine[]
  creditNoteLines FinCreditNoteLine[]
  apBillLines     FinApBillLine[]

  @@index([companyId, sourceType, sourceId])
  @@index([companyId, taxCodeId])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, frozen])
  @@map("tax_line")
}

/**
 * D265 — Local TEJ XML draft + SHA-256 history.
 * NOT an official schema · NEVER transmitted · Prefs tax.tej VALIDATED required.
 */
model TaxTejExport {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  periodLabel     String    @map("period_label")
  contentSha256   String    @map("content_sha256")
  xmlContent      String    @map("xml_content") @db.Text
  prefsValueLabel String    @map("prefs_value_label")
  lawRef          String?   @map("law_ref")
  schemaNote      String    @map("schema_note")
  transmission    String    @default("DISABLED")
  /** D285 — META_DRAFT (empty) | WITHHOLDING_PACK (from CERTIFICATE_READY). */
  packKind        String    @default("META_DRAFT") @map("pack_kind")
  withholdingCount Int      @default(0) @map("withholding_count")
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  version         Int       @default(0)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, contentSha256])
  @@map("tax_tej_export")
}

/**
 * D282 — RAS withholding object (retenue à la source).
 * TEJ Center consumes VALIDATED rows for XML prep later.
 * Never invents rates — Prefs tax.ras VALIDATED required to CALCULATED.
 */
enum TaxWithholdingStatus {
  DETECTED
  CALCULATED
  VALIDATED
  CERTIFICATE_READY
  TEJ_PREPARED
  TRANSMITTED
  ACCEPTED
  REJECTED
  ARCHIVED
}

model TaxWithholding {
  id                 String                @id @default(uuid()) @db.Uuid
  companyId          String                @map("company_id") @db.Uuid
  status             TaxWithholdingStatus  @default(DETECTED)
  /** null = unknown (Prefs pending); true/false after detection. */
  applicable         Boolean?
  decisionReason     String                @map("decision_reason") @db.Text
  decisionCode       String                @map("decision_code")
  supplierId         String?               @map("supplier_id") @db.Uuid
  apBillId           String?               @map("ap_bill_id") @db.Uuid
  apPaymentId        String?               @map("ap_payment_id") @db.Uuid
  /** D286 — AR invoice link (client RAS when withholdingArEnabled). */
  arInvoiceId        String?               @map("ar_invoice_id") @db.Uuid
  /** AP = supplier disbursement; AR = client invoice. */
  side               String                @default("AP")
  vendorName         String                @map("vendor_name")
  baseAmount         Decimal               @map("base_amount") @db.Decimal(18, 3)
  rateBps            Int?                  @map("rate_bps")
  withholdingAmount  Decimal               @default(0) @map("withholding_amount") @db.Decimal(18, 3)
  netPayable         Decimal?              @map("net_payable") @db.Decimal(18, 3)
  currency           String                @default("TND")
  lawRef             String?               @map("law_ref")
  periodLabel        String?               @map("period_label")
  prefsSnapshotJson  Json                  @default("{}") @map("prefs_snapshot_json")
  isStubRate         Boolean               @default(false) @map("is_stub_rate")
  /** D284 — local RAS certificate body (not official MF form). */
  certificateBody    String?               @map("certificate_body") @db.Text
  certificateSha256  String?               @map("certificate_sha256")
  certificateAt      DateTime?             @map("certificate_at") @db.Timestamptz(6)
  /** D285 — TEJ local XML pack that consumed this row. */
  tejExportId        String?               @map("tej_export_id") @db.Uuid
  version            Int                   @default(0)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?             @map("deleted_at") @db.Timestamptz(6)

  @@index([companyId, status])
  @@index([companyId, periodLabel])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, apPaymentId])
  @@index([companyId, supplierId])
  @@index([companyId, arInvoiceId])
  @@index([companyId, side])
  @@unique([companyId, apPaymentId])
  @@unique([companyId, arInvoiceId])
  @@map("tax_withholding")
}

