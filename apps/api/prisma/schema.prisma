  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  invoice FinInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  taxCode TaxCode    @relation(fields: [taxCodeId], references: [id])
  product PrdProduct? @relation(fields: [productId], references: [id], onDelete: Restrict)
  taxLine TaxLine?    @relation(fields: [taxLineId], references: [id], onDelete: SetNull)

