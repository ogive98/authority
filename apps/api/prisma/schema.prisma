generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- core_* platform kernel ---

model CoreOutbox {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String?   @map("company_id") @db.Uuid
  aggregateType   String    @map("aggregate_type")
  aggregateId     String    @map("aggregate_id") @db.Uuid
  eventType       String    @map("event_type")
  eventVersion    Int       @default(1) @map("event_version")
  payloadJson     Json      @map("payload_json")
  headers         Json?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(6)
  publishAttempts Int       @default(0) @map("publish_attempts")

  @@index([companyId, createdAt(sort: Desc)])
  @@index([publishedAt])
  @@map("core_outbox")
}

model CoreOutboxDlq {
  id              String   @id @default(uuid()) @db.Uuid
  outboxId        String   @map("outbox_id") @db.Uuid
  companyId       String?  @map("company_id") @db.Uuid
  aggregateType   String   @map("aggregate_type")
  aggregateId     String   @map("aggregate_id") @db.Uuid
  eventType       String   @map("event_type")
  eventVersion    Int      @map("event_version")
  payloadJson     Json     @map("payload_json")
  headers         Json?
  lastError       String   @map("last_error")
  publishAttempts Int      @map("publish_attempts")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  failedAt        DateTime @default(now()) @map("failed_at") @db.Timestamptz(6)

  @@index([companyId, failedAt(sort: Desc)])
  @@index([outboxId])
  @@index([eventType])
  @@map("core_outbox_dlq")
}

model CoreProcessedEvent {
  id          String   @id @default(uuid()) @db.Uuid
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@unique([consumer, eventId])
  @@index([processedAt])
  @@map("core_processed_event")
}

model CoreNumberingSeries {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  siteId    String?   @map("site_id") @db.Uuid
  docType   String    @map("doc_type")
  year      Int
  prefix    String
  nextValue Int       @default(1) @map("next_value")
  padding   Int       @default(6)
  version   Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([companyId, siteId, docType, year])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("core_numbering_series")
}

model CoreFile {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  bucket     String
  key        String
  mime       String
  size       BigInt
  checksum   String?
  virusScan  String?   @map("virus_scan")
  version    Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([companyId, createdAt(sort: Desc)])
  @@map("core_file")
}

model CoreSearchIndex {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  content    String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([companyId, entityType])
  @@map("core_search_index")
}

// --- iam_* identity kernel ---

enum IamUserStatus {
  INVITED
  ACTIVE
  LOCKED
  DISABLED
}

enum IamLifecycleStatus {
  ACTIVE
  REVOKED
}

enum IamSessionRealm {
  BUSINESS
  SUPER_ADMIN
  CUSTOMER_PORTAL
}

enum IamMfaPurpose {
  BUSINESS
  SUPER_ADMIN
}

model IamUser {
  id          String        @id @default(uuid()) @db.Uuid
  email       String        @unique
  displayName String        @map("display_name")
  status      IamUserStatus @default(INVITED)
  locale      String        @default("fr-TN")
  timezone    String        @default("Africa/Tunis")
  mfaEnabled  Boolean       @default(false) @map("mfa_enabled")
  /** Public path or absolute URL for profile photo (D157). */
  avatarUrl   String?       @map("avatar_url")
  passwordHash String?      @map("password_hash")
  version     Int           @default(0)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(6)

  sessions               IamSession[]
  mfaDevices             IamMfaDevice[]
  devices                IamDevice[]
  loginAttempts          IamLoginAttempt[]
  assignments            OrgUserAssignment[]
  superAdminMembership   IamSuperAdminMembership?
  portalMemberships      PtlMembership[]
  invite                 IamInvite?

  @@map("iam_user")
}

/** One-time business invite (D118). Plain token never stored — hash only. */
model IamInvite {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @unique @map("user_id") @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user IamUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("iam_invite")
}

model IamSession {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  env         String
  ip          String?
  userAgent   String?            @map("user_agent")
  expiresAt   DateTime           @map("expires_at") @db.Timestamptz(6)
  refreshHash String?            @map("refresh_hash")
  realm       IamSessionRealm    @default(BUSINESS)
  status      IamLifecycleStatus @default(ACTIVE)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  user IamUser @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([refreshHash])
  @@map("iam_session")
}

model IamMfaDevice {
  id         String             @id @default(uuid()) @db.Uuid
  userId     String             @map("user_id") @db.Uuid
  purpose    IamMfaPurpose      @default(BUSINESS)
  secretEnc  String             @map("secret_enc")
  lastUsedAt DateTime?          @map("last_used_at") @db.Timestamptz(6)
  status     IamLifecycleStatus @default(ACTIVE)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  user IamUser @relation(fields: [userId], references: [id])

  @@index([userId, purpose])
  @@map("iam_mfa_device")
}

model IamSuperAdminMembership {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @unique @map("user_id") @db.Uuid
  status    IamLifecycleStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  user IamUser @relation(fields: [userId], references: [id])

  @@map("iam_super_admin_membership")
}

model IamDevice {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  name      String?
  fingerprint String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user IamUser @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("iam_device")
}

model IamLoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  email     String?
  ip        String?
  success   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user IamUser? @relation(fields: [userId], references: [id])

  @@index([email, createdAt(sort: Desc)])
  @@map("iam_login_attempt")
}

enum IamGrantEffect {
  ALLOW
  DENY
}

enum IamGrantSubject {
  USER
  ROLE
}

model IamGrant {
  id            String             @id @default(uuid()) @db.Uuid
  permissionKey String             @map("permission_key")
  effect        IamGrantEffect     @default(ALLOW)
  subjectType   IamGrantSubject    @map("subject_type")
  subjectId     String             @map("subject_id")
  companyId     String?            @map("company_id") @db.Uuid
  siteId        String?            @map("site_id") @db.Uuid
  warehouseId   String?            @map("warehouse_id") @db.Uuid
  status        IamLifecycleStatus @default(ACTIVE)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([subjectType, subjectId, permissionKey])
  @@index([companyId, permissionKey])
  @@map("iam_grant")
}

// --- org_* organization kernel ---

enum OrgCompanyStatus {
  ACTIVE
  SUSPENDED
}

enum OrgSiteType {
  USINE
  DEPOT
  BUREAU
}

enum OrgWarehouseType {
  FROID
  SEC
  QUAI
}

model OrgCompany {
  id        String           @id @default(uuid()) @db.Uuid
  code      String           @unique
  legalName String           @map("legal_name")
  country   String           @default("TN")
  currency  String           @default("TND")
  timezone  String           @default("Africa/Tunis")
  vatNumber String?          @map("vat_number")
  status    OrgCompanyStatus @default(ACTIVE)
  version   Int              @default(0)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?        @map("deleted_at") @db.Timestamptz(6)

  sites       OrgSite[]
  assignments OrgUserAssignment[]

  @@map("org_company")
}

model OrgSite {
  id        String         @id @default(uuid()) @db.Uuid
  companyId String         @map("company_id") @db.Uuid
  code      String
  type      OrgSiteType
  timezone  String         @default("Africa/Tunis")
  status    OrgCompanyStatus @default(ACTIVE)
  version   Int            @default(0)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?      @map("deleted_at") @db.Timestamptz(6)

  company    OrgCompany    @relation(fields: [companyId], references: [id])
  warehouses OrgWarehouse[]

  @@unique([companyId, code])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("org_site")
}

model OrgWarehouse {
  id         String           @id @default(uuid()) @db.Uuid
  companyId  String           @map("company_id") @db.Uuid
  siteId     String           @map("site_id") @db.Uuid
  code       String
  type       OrgWarehouseType
  tempMinMax String?          @map("temp_min_max")
  status     OrgCompanyStatus @default(ACTIVE)
  version    Int              @default(0)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime?        @map("deleted_at") @db.Timestamptz(6)

  site OrgSite @relation(fields: [siteId], references: [id])

  @@unique([companyId, code])
  @@index([companyId, siteId])
  @@map("org_warehouse")
}

model OrgDepartment {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  code      String
  name      String
  version   Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([companyId, code])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("org_department")
}

model OrgTeam {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  departmentId String?   @map("department_id") @db.Uuid
  code         String
  name         String
  version      Int       @default(0)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([companyId, code])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("org_team")
}

model OrgUserAssignment {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  siteId    String?   @map("site_id") @db.Uuid
  roleCode  String?   @map("role_code")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  company OrgCompany @relation(fields: [companyId], references: [id])
  user    IamUser    @relation(fields: [userId], references: [id])

  @@unique([companyId, userId])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("org_user_assignment")
}

// --- mod_* module registry ---

enum ModModuleStatus {
  ENABLED
  DISABLED
}

model ModModuleState {
  id        String          @id @default(uuid()) @db.Uuid
  companyId String          @map("company_id") @db.Uuid
  moduleKey String          @map("module_key")
  status    ModModuleStatus @default(DISABLED)
  version   Int             @default(0)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([companyId, moduleKey])
  @@index([companyId])
  @@map("mod_module_state")
}

model ModFlag {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  flagKey   String   @map("flag_key")
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([companyId, flagKey])
  @@index([companyId])
  @@map("mod_flag")
}

// --- set_* settings hierarchy (SOC-11) ---

enum SetLevel {
  SYSTEM
  COMPANY
  ROLE
  USER
}

model SetDef {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  valueType   String   @map("value_type")
  defaultJson Json     @map("default_json")
  description String?
  isPrefOnly  Boolean  @default(true) @map("is_pref_only")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  values SetValue[]

  @@map("set_def")
}

model SetValue {
  id        String    @id @default(uuid()) @db.Uuid
  defKey    String    @map("def_key")
  level     SetLevel
  scopeKey  String    @map("scope_key")
  companyId String?   @map("company_id") @db.Uuid
  valueJson Json      @map("value_json")
  version   Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  def SetDef @relation(fields: [defKey], references: [key])

  @@unique([defKey, scopeKey])
  @@index([companyId, level])
  @@map("set_value")
}

/**
 * Expert-validated legal parameters (D091) — FODEC / timbre / CNSS / IRPP / TFP.
 * Never seeded with invented rates; lawRef + expertValidatedAt required on write.
 * VAT stays in Tax Engine (`tax_rate`), not here.
 */
model SetExpertise {
  id                 String    @id @default(uuid()) @db.Uuid
  companyId          String    @map("company_id") @db.Uuid
  slotKey            String    @map("slot_key")
  /** Human summary provided by expert — never auto-invented. */
  valueLabel         String    @map("value_label")
  /** Optional structured rate in basis points (100 = 1%). */
  rateBps            Int?      @map("rate_bps")
  /** Optional fixed amount in millimes (timbre). */
  amountMilli        Int?      @map("amount_milli")
  lawRef             String    @map("law_ref")
  expertValidatedAt  DateTime  @map("expert_validated_at") @db.Timestamptz(6)
  notes              String?
  version            Int       @default(0)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([companyId, slotKey])
  @@index([companyId, slotKey])
  @@map("set_expertise")
}

// --- aud_* immutable audit ---

model AudEvent {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String?  @map("company_id") @db.Uuid
  siteId        String?  @map("site_id") @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  action        String
  entityType    String?  @map("entity_type")
  entityId      String?  @map("entity_id") @db.Uuid
  beforeJson    Json?    @map("before_json")
  afterJson     Json?    @map("after_json")
  ip            String?
  device        String?
  correlationId String?  @map("correlation_id")
  mode          String?
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([companyId, occurredAt(sort: Desc)])
  @@map("aud_event")
}

// --- lic_* hybrid license stub (SOC-10) ---

model LicCurrent {
  id           String    @id @default(uuid()) @db.Uuid
  payloadJson  Json      @map("payload_json")
  signature    String
  cachedUntil  DateTime? @map("cached_until") @db.Timestamptz(6)
  lastOnlineAt DateTime? @map("last_online_at") @db.Timestamptz(6)
  version      Int       @default(0)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("lic_current")
}

model LicHistory {
  id          String   @id @default(uuid()) @db.Uuid
  payloadJson Json     @map("payload_json")
  signature   String
  activatedAt DateTime @default(now()) @map("activated_at") @db.Timestamptz(6)

  @@index([activatedAt(sort: Desc)])
  @@map("lic_history")
}

// --- thunder_* orchestration stubs ---

enum ThunderJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  PAUSED_BY_MODULE
}

enum ThunderWorkflowStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model ThunderJob {
  id             String           @id @default(uuid()) @db.Uuid
  companyId      String?          @map("company_id") @db.Uuid
  jobType        String           @map("job_type")
  queue          String           @default("ops")
  priority       Int              @default(2)
  idempotencyKey String?          @map("idempotency_key")
  payloadHash    String?          @map("payload_hash")
  payloadRef     String?          @map("payload_ref")
  payloadJson    Json?            @map("payload_json")
  resultJson     Json?            @map("result_json")
  errorJson      Json?            @map("error_json")
  bullJobId      String?          @map("bull_job_id")
  status         ThunderJobStatus @default(PENDING)
  attempts       Int              @default(0)
  scheduledAt    DateTime?        @map("scheduled_at") @db.Timestamptz(6)
  startedAt      DateTime?        @map("started_at") @db.Timestamptz(6)
  heartbeatAt    DateTime?        @map("heartbeat_at") @db.Timestamptz(6)
  finishedAt     DateTime?        @map("finished_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([companyId, idempotencyKey])
  @@index([companyId, status, createdAt(sort: Desc)])
  @@map("thunder_job")
}

model ThunderWorkflowInstance {
  id           String                @id @default(uuid()) @db.Uuid
  companyId    String                @map("company_id") @db.Uuid
  definitionId String                @map("definition_id")
  version      Int                   @default(1)
  status       ThunderWorkflowStatus @default(PENDING)
  cursorStep   String?               @map("cursor_step")
  dataJson     Json?                 @map("data_json")
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([companyId, status, createdAt(sort: Desc)])
  @@map("thunder_workflow_instance")
}

model ThunderDlqEntry {
  id          String   @id @default(uuid()) @db.Uuid
  jobId       String   @map("job_id") @db.Uuid
  companyId   String?  @map("company_id") @db.Uuid
  jobType     String   @map("job_type")
  queue       String
  payloadJson Json     @map("payload_json")
  lastError   String   @map("last_error")
  attempts    Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([companyId, createdAt(sort: Desc)])
  @@index([jobId])
  @@map("thunder_dlq")
}

model ThunderRuleDef {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String?  @map("company_id") @db.Uuid
  moduleKey       String   @map("module_key")
  name            String
  enabled         Boolean  @default(true)
  priority        Int      @default(100)
  eventPattern    String   @map("event_pattern")
  conditionsJson  Json     @map("conditions_json")
  actionsJson     Json     @map("actions_json")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([enabled, priority])
  @@index([companyId, moduleKey])
  @@index([eventPattern])
  @@map("thunder_rule_def")
}

// --- THU-PLAT-01 signals / recommendations (non-AI) ---

enum ThuSignalSeverity {
  INFO
  WARN
  CRITICAL
}

enum ThuSignalStatus {
  OPEN
  ACK
  CLOSED
}

