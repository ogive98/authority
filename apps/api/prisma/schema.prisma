// --- atm_* Automation ASSISTED profiles (D245) ---

enum AtmProfileMode {
  ASSISTED
  REQUIRES_APPROVAL
  /** Reserved — rejected for critical action kinds in V0. */
  FULL_AUTO
}

enum AtmTriggerKind {
  FINANCE_OVERDUE_OPEN_ITEMS
  PORTAL_PAYMENT_DECLARATION_SUBMITTED
  SALES_DRAFT_ORDER_STALE
}

enum AtmActionKind {
  /** Emit suggestion event + run log only. */
  NOTIFY
  /** Hint to prepare dunning — no FinDunningDraft create. */
  PREPARE_DUNNING_HINT
  /** Hint only — no sales confirm. */
  ORDER_REVIEW_HINT
}

enum AtmRunStatus {
  SUGGESTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SKIPPED
  FAILED
}

/**
 * D245 — company automation profile (human-gated).
 * FULL_AUTO is enum-only; service rejects it for mutating hints.
 * Never auto-confirms orders / FinPayment / GL.
 */
model AtmProfile {
  id          String         @id @default(uuid()) @db.Uuid
  companyId   String         @map("company_id") @db.Uuid
  code        String
  name        String
  description String?
  mode        AtmProfileMode @default(ASSISTED)
  triggerKind AtmTriggerKind @map("trigger_kind")
  actionKind  AtmActionKind  @map("action_kind")
  enabled     Boolean        @default(true)
  shadowMode  Boolean        @default(false) @map("shadow_mode")
  /** Limited config (thresholds) — no eval / arbitrary JS. */
  configJson  Json           @default("{}") @map("config_json")
  version     Int            @default(0)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz(6)

  runs AtmRunLog[]

  @@unique([companyId, code])
  @@index([companyId, enabled, updatedAt(sort: Desc)])
  @@index([companyId, triggerKind])
  @@map("atm_profile")
}

model AtmRunLog {
  id               String       @id @default(uuid()) @db.Uuid
  companyId        String       @map("company_id") @db.Uuid
  profileId        String       @map("profile_id") @db.Uuid
  number           String
  status           AtmRunStatus @default(SUGGESTED)
  triggerRef       String?      @map("trigger_ref")
  summary          String
  payloadJson      Json         @default("{}") @map("payload_json")
  resultJson       Json         @default("{}") @map("result_json")
  createdByUserId  String?      @map("created_by_user_id") @db.Uuid
  reviewedByUserId String?      @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime?    @map("reviewed_at") @db.Timestamptz(6)
  reviewNote       String?      @map("review_note")
  version          Int          @default(0)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz(6)

  profile AtmProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([companyId, number])
  @@index([companyId, status, createdAt(sort: Desc)])
  @@index([companyId, profileId, createdAt(sort: Desc)])
  @@map("atm_run_log")
}

/**
 * Fleet Soft Glass (D253+) — vehicles + assignment + carnet (D257).
 * Out: GPS · vehicleId on DlvRound · HR driver FK.
 */
enum FltVehicleStatus {
  ACTIVE
  MAINTENANCE
  OUT
  ARCHIVED
}

enum FltLogKind {
  ODOMETER
  OIL_CHANGE
  TIRES
  FUEL
  OTHER
}

model FltVehicle {
  id                String           @id @default(uuid()) @db.Uuid
  companyId         String           @map("company_id") @db.Uuid
  code              String
  plate             String
  capacityKg        Decimal?         @map("capacity_kg") @db.Decimal(18, 3)
  cold              Boolean          @default(false)
  odometerKm        Decimal?         @map("odometer_km") @db.Decimal(18, 3)
  usualDriverLabel  String?          @map("usual_driver_label")
  nextServiceKm     Decimal?         @map("next_service_km") @db.Decimal(18, 3)
  nextServiceAt     DateTime?        @map("next_service_at") @db.Date
  status            FltVehicleStatus @default(ACTIVE)
  notes             String?
  version           Int              @default(0)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?        @map("deleted_at") @db.Timestamptz(6)

  assignments FltAssignment[]
  maintAssets MntAsset[]
  logs        FltVehicleLog[]

  @@unique([companyId, code])
  @@unique([companyId, plate])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, status])
  @@map("flt_vehicle")
}

model FltVehicleLog {
  id          String     @id @default(uuid()) @db.Uuid
  companyId   String     @map("company_id") @db.Uuid
  vehicleId   String     @map("vehicle_id") @db.Uuid
  kind        FltLogKind
  occurredAt  DateTime   @map("occurred_at") @db.Timestamptz(6)
  odometerKm  Decimal?   @map("odometer_km") @db.Decimal(18, 3)
  liters      Decimal?   @db.Decimal(18, 3)
  amountTnd   Decimal?   @map("amount_tnd") @db.Decimal(18, 3)
  notes       String?
  version     Int        @default(0)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?  @map("deleted_at") @db.Timestamptz(6)

  vehicle FltVehicle @relation(fields: [vehicleId], references: [id])

  @@index([companyId, vehicleId, occurredAt(sort: Desc)])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("flt_vehicle_log")
}

model FltAssignment {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  roundId     String    @map("round_id") @db.Uuid
  vehicleId   String    @map("vehicle_id") @db.Uuid
  driverLabel String    @map("driver_label")
  payloadKg   Decimal?  @map("payload_kg") @db.Decimal(18, 3)
  notes       String?
  assignedAt  DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  version     Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  round   DlvRound   @relation(fields: [roundId], references: [id])
  vehicle FltVehicle @relation(fields: [vehicleId], references: [id])

  @@index([companyId, assignedAt(sort: Desc)])
  @@index([companyId, roundId])
  @@index([companyId, vehicleId])
  @@map("flt_assignment")
}

/**
 * Maintenance Soft Glass V0 (D256) — assets + WO · optional fleet vehicle (1A) ·
 * preventive date UI (2B). Out: Thunder preventive job · parts · OF block · full CMMS.
 */
enum MntAssetStatus {
  ONLINE
  DOWN
}

enum MntWoStatus {
  OPEN
  DONE
}

enum MntWoType {
  BREAKDOWN
  PREVENTIVE
}

model MntAsset {
  id               String         @id @default(uuid()) @db.Uuid
  companyId        String         @map("company_id") @db.Uuid
  code             String
  label            String
  type             String
  status           MntAssetStatus @default(ONLINE)
  vehicleId        String?        @map("vehicle_id") @db.Uuid
  nextPreventiveAt DateTime?      @map("next_preventive_at") @db.Date
  notes            String?
  version          Int            @default(0)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?      @map("deleted_at") @db.Timestamptz(6)

  vehicle FltVehicle? @relation(fields: [vehicleId], references: [id])
  workOrders MntWo[]

  @@unique([companyId, code])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, status])
  @@index([companyId, nextPreventiveAt])
  @@index([companyId, vehicleId])
  @@map("mnt_asset")
}

model MntWo {
  id          String      @id @default(uuid()) @db.Uuid
  companyId   String      @map("company_id") @db.Uuid
  assetId     String      @map("asset_id") @db.Uuid
  type        MntWoType
  status      MntWoStatus @default(OPEN)
  title       String
  notes       String?
  openedAt    DateTime    @default(now()) @map("opened_at") @db.Timestamptz(6)
  doneAt      DateTime?   @map("done_at") @db.Timestamptz(6)
  version     Int         @default(0)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?   @map("deleted_at") @db.Timestamptz(6)

  asset MntAsset @relation(fields: [assetId], references: [id])

  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, status])
  @@index([companyId, assetId])
  @@map("mnt_wo")
}

// --- frg_* FORGE extension foundation (D277) — contracts only, no AI runtime ---

enum FrgExtensionStatus {
  DRAFT
  ANALYZING
  GENERATING
  VALIDATING
  TESTING
  READY_FOR_REVIEW
  APPROVED
  ACTIVE
  SUSPENDED
  DISABLED
  FAILED
  ARCHIVED
}

enum FrgFeatureRequestStatus {
  RECEIVED
  ANALYZING
  PLANNED
  WAITING_APPROVAL
  IMPLEMENTING
  TESTING
  READY
  DEPLOYED
  REJECTED
  FAILED
}

enum FrgMetadataType {
  entity
  field
  action
  view
  form
  table
  workflow
  report
  automation
}

enum FrgMetadataStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/** Tenant-scoped extension manifest (Phase 1 — data only, not executable bundle). */
model FrgExtension {
  id                    String             @id @default(uuid()) @db.Uuid
  companyId             String             @map("company_id") @db.Uuid
  key                   String
  name                  String
  description           String?
  manifestVersion       String             @map("manifest_version")
  status                FrgExtensionStatus @default(DRAFT)
  tenantScope           String             @default("company") @map("tenant_scope")
  manifestJson          Json               @default("{}") @map("manifest_json")
  dependenciesJson      Json               @default("[]") @map("dependencies_json")
  compatibleCoreVersion String?            @map("compatible_core_version")
  createdByUserId       String?            @map("created_by_user_id") @db.Uuid
  version               Int                @default(0)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?          @map("deleted_at") @db.Timestamptz(6)

  metadataDefinitions FrgMetadataDefinition[]
  featureRequests     FrgFeatureRequest[]

  @@unique([companyId, key])
  @@index([companyId, status])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("frg_extension")
}

/** Human intake for tenant-specific functionality — no auto-implementation in Phase 1. */
model FrgFeatureRequest {
  id                  String                  @id @default(uuid()) @db.Uuid
  companyId           String                  @map("company_id") @db.Uuid
  title               String
  description         String?
  status              FrgFeatureRequestStatus @default(RECEIVED)
  priority            Int                     @default(0)
  source              String                  @default("manual")
  requestedByUserId   String?                 @map("requested_by_user_id") @db.Uuid
  affectedModulesJson Json                    @default("[]") @map("affected_modules_json")
  extensionId         String?                 @map("extension_id") @db.Uuid
  version             Int                     @default(0)
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?               @map("deleted_at") @db.Timestamptz(6)

  extension FrgExtension? @relation(fields: [extensionId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, extensionId])
  @@map("frg_feature_request")
}

/** Extensible metadata definitions — complements manifests/command-catalog, does not replace them. */
model FrgMetadataDefinition {
  id           String            @id @default(uuid()) @db.Uuid
  companyId    String            @map("company_id") @db.Uuid
  key          String
  type         FrgMetadataType
  moduleKey    String            @map("module_key")
  extensionId  String?           @map("extension_id") @db.Uuid
  schemaJson   Json              @default("{}") @map("schema_json")
  status       FrgMetadataStatus @default(DRAFT)
  version      Int               @default(0)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?         @map("deleted_at") @db.Timestamptz(6)

  extension FrgExtension? @relation(fields: [extensionId], references: [id], onDelete: SetNull)

  @@unique([companyId, key])
  @@index([companyId, type])
  @@index([companyId, moduleKey])
  @@index([companyId, extensionId])
  @@map("frg_metadata_definition")
}
