// --- fin_* Finance (AR deepen D072 — Invoice / Payment / Allocation / Instruments) ---

enum FinOpenItemSide {
  AR
  AP
}

enum FinOpenItemStatus {
  OPEN
  PARTIAL
  CLOSED
}

enum FinInvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum FinCreditNoteStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum FinPaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  CHEQUE
  BILL_OF_EXCHANGE
  OTHER
}

enum FinPaymentStatus {
  DRAFT
  POSTED
  REVERSED
}

/** A–G allocation policies (simulate then confirm). */
enum FinAllocationPolicy {
  OLDEST_FIRST      // A
  NEWEST_FIRST      // B
  PROPORTIONAL      // C
  COMPLETION_FIRST  // D — smallest open first
  LARGEST_FIRST     // E
  OVERDUE_FIRST     // F
  MANUAL            // G
}

enum FinInstrumentType {
  CHEQUE
  BILL_OF_EXCHANGE
}

enum FinInstrumentStatus {
  RECEIVED
  DEPOSITED
  PRESENTED
  CLEARED
  REJECTED
  CANCELLED
}

enum FinPromiseStatus {
  OPEN
  KEPT
  BROKEN
  CANCELLED
}

model FinInvoice {
  id           String          @id @default(uuid()) @db.Uuid
  companyId    String          @map("company_id") @db.Uuid
  number       String
  customerId   String          @map("customer_id") @db.Uuid
  status       FinInvoiceStatus @default(DRAFT)
  salesOrderId String?         @map("sales_order_id") @db.Uuid
  shipmentId   String?         @map("shipment_id") @db.Uuid
  currency     String          @default("TND")
  /** Gross TTC — HT + TVA + FODEC + timbre (expertise when VALIDATED). */
  amountTotal  Decimal         @map("amount_total") @db.Decimal(18, 3)
  amountHt     Decimal         @default(0) @map("amount_ht") @db.Decimal(18, 3)
  amountTax    Decimal         @default(0) @map("amount_tax") @db.Decimal(18, 3)
  /** FODEC amount — 0 unless Préférences tax.fodec VALIDATED with rateBps. */
  amountFodec  Decimal         @default(0) @map("amount_fodec") @db.Decimal(18, 3)
  /** Timbre amount — 0 unless Préférences tax.timbre VALIDATED with amountMilli. */
  amountTimbre Decimal         @default(0) @map("amount_timbre") @db.Decimal(18, 3)
  dueDate      DateTime?       @map("due_date") @db.Date
  issuedAt     DateTime?       @map("issued_at") @db.Timestamptz(6)
  label        String?
  notes        String?
  version      Int             @default(0)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?       @map("deleted_at") @db.Timestamptz(6)

  openItems   FinOpenItem[]
  lines       FinInvoiceLine[]
  creditNotes FinCreditNote[]

  @@unique([companyId, number])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, customerId, status])
  @@index([companyId, salesOrderId])
  @@map("fin_invoice")
}

model FinInvoiceLine {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  lineNo      Int      @map("line_no")
  description String
  qty         Decimal  @db.Decimal(18, 3)
  unitPriceHt Decimal  @map("unit_price_ht") @db.Decimal(18, 3)
  taxCodeId   String   @map("tax_code_id") @db.Uuid
  amountHt    Decimal  @map("amount_ht") @db.Decimal(18, 3)
  amountTax   Decimal  @map("amount_tax") @db.Decimal(18, 3)
  amountTtc   Decimal  @map("amount_ttc") @db.Decimal(18, 3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  invoice FinInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  taxCode TaxCode   @relation(fields: [taxCodeId], references: [id])

  @@unique([invoiceId, lineNo])
  @@index([companyId, invoiceId])
  @@map("fin_invoice_line")
}

/** Credit note / avoir V0 (D192) — invoice-linked only; no stock restore. */
model FinCreditNote {
  id                String              @id @default(uuid()) @db.Uuid
  companyId         String              @map("company_id") @db.Uuid
  number            String
  invoiceId         String              @map("invoice_id") @db.Uuid
  customerId        String              @map("customer_id") @db.Uuid
  status            FinCreditNoteStatus @default(DRAFT)
  currency          String              @default("TND")
  amountHt          Decimal             @default(0) @map("amount_ht") @db.Decimal(18, 3)
  amountTax         Decimal             @default(0) @map("amount_tax") @db.Decimal(18, 3)
  amountFodec       Decimal             @default(0) @map("amount_fodec") @db.Decimal(18, 3)
  amountTimbre      Decimal             @default(0) @map("amount_timbre") @db.Decimal(18, 3)
  amountTotal       Decimal             @map("amount_total") @db.Decimal(18, 3)
  /** Portion applied to linked AR on issue — min(CN TTC, amountOpen). */
  amountAppliedToAr Decimal             @default(0) @map("amount_applied_to_ar") @db.Decimal(18, 3)
  /** Remainder after AR reduction — customer credit, no auto-refund. */
  amountUnapplied   Decimal             @default(0) @map("amount_unapplied") @db.Decimal(18, 3)
  reason            String?
  notes             String?
  issuedAt          DateTime?           @map("issued_at") @db.Timestamptz(6)
  version           Int                 @default(0)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?           @map("deleted_at") @db.Timestamptz(6)

  invoice FinInvoice          @relation(fields: [invoiceId], references: [id])
  lines   FinCreditNoteLine[]

  @@unique([companyId, number])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, invoiceId, status])
  @@index([companyId, customerId, status])
  @@map("fin_credit_note")
}

model FinCreditNoteLine {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  creditNoteId String   @map("credit_note_id") @db.Uuid
  lineNo       Int      @map("line_no")
  description  String
  qty          Decimal  @db.Decimal(18, 3)
  unitPriceHt  Decimal  @map("unit_price_ht") @db.Decimal(18, 3)
  taxCodeId    String   @map("tax_code_id") @db.Uuid
  amountHt     Decimal  @map("amount_ht") @db.Decimal(18, 3)
  amountTax    Decimal  @map("amount_tax") @db.Decimal(18, 3)
  amountTtc    Decimal  @map("amount_ttc") @db.Decimal(18, 3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  creditNote FinCreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  taxCode    TaxCode       @relation(fields: [taxCodeId], references: [id])

  @@unique([creditNoteId, lineNo])
  @@index([companyId, creditNoteId])
  @@map("fin_credit_note_line")
}

model FinOpenItem {
  id           String            @id @default(uuid()) @db.Uuid
  companyId    String            @map("company_id") @db.Uuid
  number       String
  customerId   String            @map("customer_id") @db.Uuid
  side         FinOpenItemSide   @default(AR)
  status       FinOpenItemStatus @default(OPEN)
  salesOrderId String?           @map("sales_order_id") @db.Uuid
  invoiceId    String?           @map("invoice_id") @db.Uuid
  currency     String            @default("TND")
  amountTotal  Decimal           @map("amount_total") @db.Decimal(18, 3)
  amountOpen   Decimal           @map("amount_open") @db.Decimal(18, 3)
  dueDate      DateTime?         @map("due_date") @db.Date
  label        String?
  notes        String?
  version      Int               @default(0)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?         @map("deleted_at") @db.Timestamptz(6)

  invoice     FinInvoice?        @relation(fields: [invoiceId], references: [id])
  allocations FinAllocation[]
  promises    FinPromiseToPay[]
  dunningDrafts FinDunningDraft[]

  @@unique([companyId, number])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, invoiceId])
  @@map("fin_open_item")
}

model FinPayment {
  id                 String           @id @default(uuid()) @db.Uuid
  companyId          String           @map("company_id") @db.Uuid
  number             String
  customerId         String           @map("customer_id") @db.Uuid
  amount             Decimal          @db.Decimal(18, 3)
  amountUnallocated  Decimal          @map("amount_unallocated") @db.Decimal(18, 3)
  currency           String           @default("TND")
  method             FinPaymentMethod @default(OTHER)
  status             FinPaymentStatus @default(POSTED)
  paymentDate        DateTime         @map("payment_date") @db.Date
  accountingDate     DateTime         @map("accounting_date") @db.Date
  reference          String?
  notes              String?
  version            Int              @default(0)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?        @map("deleted_at") @db.Timestamptz(6)

  allocations FinAllocation[]
  instruments FinPaymentInstrument[]
  bankMatches FinBankMatch[]

  @@unique([companyId, number])
  @@index([companyId, customerId, paymentDate(sort: Desc)])
  @@index([companyId, status])
  @@map("fin_payment")
}

model FinAllocation {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  openItemId String   @map("open_item_id") @db.Uuid
  paymentId  String?  @map("payment_id") @db.Uuid
  amount     Decimal  @db.Decimal(18, 3)
  paidAt     DateTime @map("paid_at") @db.Timestamptz(6)
  note       String?
  version    Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  openItem FinOpenItem @relation(fields: [openItemId], references: [id], onDelete: Cascade)
  payment  FinPayment? @relation(fields: [paymentId], references: [id])

  @@index([companyId, openItemId])
  @@index([companyId, paymentId])
  @@index([companyId, paidAt(sort: Desc)])
  @@map("fin_allocation")
}

model FinPaymentInstrument {
  id          String              @id @default(uuid()) @db.Uuid
  companyId   String              @map("company_id") @db.Uuid
  paymentId   String              @map("payment_id") @db.Uuid
  type        FinInstrumentType
  status      FinInstrumentStatus @default(RECEIVED)
  number      String
  bankName    String?             @map("bank_name")
  holder      String?
  amount      Decimal             @db.Decimal(18, 3)
  issueDate   DateTime?           @map("issue_date") @db.Date
  receiveDate DateTime?           @map("receive_date") @db.Date
  dueDate     DateTime?           @map("due_date") @db.Date
  depositDate DateTime?           @map("deposit_date") @db.Date
  clearedAt   DateTime?           @map("cleared_at") @db.Timestamptz(6)
  rejectedAt  DateTime?           @map("rejected_at") @db.Timestamptz(6)
  rejectReason String?            @map("reject_reason")
  version     Int                 @default(0)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?           @map("deleted_at") @db.Timestamptz(6)

  payment     FinPayment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bankMatches FinBankMatch[]

  @@index([companyId, paymentId])
  @@index([companyId, status, dueDate])
  @@map("fin_payment_instrument")
}

/** Soft bank recon status — no accounting period lock (D189). */
enum FinBankLineStatus {
  UNMATCHED
  MATCHED
  IGNORED
}

/** Company bank accounts — multi-bank; GL code optional (defaults to accounting.gl.bank). */
model FinBankAccount {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  code          String
  label         String
  bankName      String?   @map("bank_name")
  /** Tunisian RIB / IBAN as opaque free text — no invented directory. */
  rib           String?
  iban          String?
  /** Optional CoA code; empty → use accounting.gl.bank at report time. */
  glAccountCode String?   @map("gl_account_code")
  currency      String    @default("TND")
  active        Boolean   @default(true)
  isDefault     Boolean   @default(false) @map("is_default")
  notes         String?
  version       Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  lines FinBankStatementLine[]

  @@unique([companyId, code])
  @@index([companyId, active])
  @@map("fin_bank_account")
}

/** Bank statement line — manual / CSV / OFX (D189–D193). Soft recon; fee GL only via explicit post. */
model FinBankStatementLine {
  id            String            @id @default(uuid()) @db.Uuid
  companyId     String            @map("company_id") @db.Uuid
  bankAccountId String            @map("bank_account_id") @db.Uuid
  lineDate      DateTime          @map("line_date") @db.Date
  /** Signed TND as-recorded: + credit (in) / − debit (out). */
  amount        Decimal           @db.Decimal(18, 3)
  currency      String            @default("TND")
  reference     String?
  counterparty  String?
  memo          String?
  /** OFX FITID — unique per account when set (D193 dedup). */
  fitId         String?           @map("fit_id")
  /** Set when explicit « Comptabiliser frais » posted (ignore alone has no GL). */
  feePostedAt   DateTime?         @map("fee_posted_at") @db.Timestamptz(6)
  status        FinBankLineStatus @default(UNMATCHED)
  version       Int               @default(0)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?         @map("deleted_at") @db.Timestamptz(6)

  bankAccount FinBankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  match       FinBankMatch?

  @@unique([bankAccountId, fitId])
  @@index([companyId, bankAccountId, lineDate(sort: Desc)])
  @@index([companyId, status])
  @@index([companyId, feePostedAt])
  @@map("fin_bank_statement_line")
}

/**
 * AP disbursement V0 (D205) — vendorName free text.
 * No supplier master, no AP bill, no GL on post or bank match.
 */
model FinApPayment {
  id             String           @id @default(uuid()) @db.Uuid
  companyId      String           @map("company_id") @db.Uuid
  number         String
  vendorName     String           @map("vendor_name")
  amount         Decimal          @db.Decimal(18, 3)
  currency       String           @default("TND")
  method         FinPaymentMethod @default(OTHER)
  status         FinPaymentStatus @default(POSTED)
  paymentDate    DateTime         @map("payment_date") @db.Date
  accountingDate DateTime         @map("accounting_date") @db.Date
  reference      String?
  notes          String?
  version        Int              @default(0)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz(6)

  bankMatches FinBankMatch[]

  @@unique([companyId, number])
  @@index([companyId, paymentDate(sort: Desc)])
  @@index([companyId, status])
  @@map("fin_ap_payment")
}

/**
 * Soft match statement line ↔ AR payment XOR instrument XOR AP disbursement.
 * No GL side-effect — bank GL stays on allocate (D073/D189) / AP has no GL (D205).
 */
model FinBankMatch {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  statementLineId String   @unique @map("statement_line_id") @db.Uuid
  paymentId       String?  @map("payment_id") @db.Uuid
  instrumentId    String?  @map("instrument_id") @db.Uuid
  apPaymentId     String?  @map("ap_payment_id") @db.Uuid
  note            String?
  matchedAt       DateTime @default(now()) @map("matched_at") @db.Timestamptz(6)
  version         Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  statementLine FinBankStatementLine  @relation(fields: [statementLineId], references: [id], onDelete: Cascade)
  payment       FinPayment?           @relation(fields: [paymentId], references: [id])
  instrument    FinPaymentInstrument? @relation(fields: [instrumentId], references: [id])
  apPayment     FinApPayment?         @relation(fields: [apPaymentId], references: [id])

  @@unique([paymentId])
  @@unique([instrumentId])
  @@unique([apPaymentId])
  @@index([companyId, matchedAt(sort: Desc)])
  @@map("fin_bank_match")
}

/** Collections promise-to-pay V0 (D087) — no auto-block on sales. */
model FinPromiseToPay {
  id           String          @id @default(uuid()) @db.Uuid
  companyId    String          @map("company_id") @db.Uuid
  number       String
  customerId   String          @map("customer_id") @db.Uuid
  openItemId   String          @map("open_item_id") @db.Uuid
  amount       Decimal         @db.Decimal(18, 3)
  currency     String          @default("TND")
  promisedDate DateTime        @map("promised_date") @db.Date
  status       FinPromiseStatus @default(OPEN)
  notes        String?
  version      Int             @default(0)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?       @map("deleted_at") @db.Timestamptz(6)

  openItem FinOpenItem @relation(fields: [openItemId], references: [id], onDelete: Cascade)

  @@unique([companyId, number])
  @@index([companyId, status, promisedDate])
  @@index([companyId, customerId])
  @@index([companyId, openItemId])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("fin_promise_to_pay")
}

/** Human-gated dunning draft — confirm then optional SMTP / WA Cloud send (D190/D194). */
enum FinDunningStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum FinDunningChannel {
  EMAIL
  WHATSAPP
}

/** Provider send outcome — confirm stays even on FAILED (lock 4A). */
enum FinDunningSendStatus {
  NONE
  SENT
  FAILED
}

/** Meta Cloud webhook delivery (D206) — independent of sendStatus (API call). */
enum FinDunningWaDeliveryStatus {
  NONE
  SENT
  DELIVERED
  READ
  FAILED
}

model FinDunningDraft {
  id                String               @id @default(uuid()) @db.Uuid
  companyId         String               @map("company_id") @db.Uuid
  number            String
  openItemId        String               @map("open_item_id") @db.Uuid
  customerId        String               @map("customer_id") @db.Uuid
  contactId         String               @map("contact_id") @db.Uuid
  channel           FinDunningChannel
  /** Days past due milestone from finance.collection.remind_days. */
  milestoneDay      Int                  @map("milestone_day")
  daysPastDue       Int                  @map("days_past_due")
  amountOpen        Decimal              @map("amount_open") @db.Decimal(18, 3)
  currency          String               @default("TND")
  subject           String
  body              String
  recipient         String
  status            FinDunningStatus     @default(DRAFT)
  confirmedAt       DateTime?            @map("confirmed_at") @db.Timestamptz(6)
  sendStatus        FinDunningSendStatus @default(NONE) @map("send_status")
  sentAt            DateTime?            @map("sent_at") @db.Timestamptz(6)
  sendError         String?              @map("send_error")
  providerMessageId String?              @map("provider_message_id")
  waDeliveryStatus  FinDunningWaDeliveryStatus @default(NONE) @map("wa_delivery_status")
  waDeliveryAt      DateTime?            @map("wa_delivery_at") @db.Timestamptz(6)
  waDeliveryError   String?              @map("wa_delivery_error")
  version           Int                  @default(0)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?            @map("deleted_at") @db.Timestamptz(6)

  openItem FinOpenItem @relation(fields: [openItemId], references: [id], onDelete: Cascade)

  @@unique([companyId, number])
  @@unique([companyId, openItemId, milestoneDay, channel])
  @@index([companyId, status, createdAt(sort: Desc)])
  @@index([companyId, openItemId])
  @@index([companyId, customerId])
  @@index([companyId, sendStatus])
  @@index([companyId, providerMessageId])
  @@map("fin_dunning_draft")
}

// --- tax_* Tax Engine V0 (D088) — Tunisia VAT catalog; CNSS/IRPP reserved for HR ---

enum TaxKind {
  VAT
}

model TaxCode {
