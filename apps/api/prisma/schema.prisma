  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  entries AccJournalEntry[]

  @@unique([companyId, code])
  @@map("acc_journal")
}

model AccJournalEntry {
  id          String         @id @default(uuid()) @db.Uuid
  companyId   String         @map("company_id") @db.Uuid
  journalId   String         @map("journal_id") @db.Uuid
  periodId    String         @map("period_id") @db.Uuid
  number      String
  status      AccEntryStatus @default(DRAFT)
  entryDate   DateTime       @map("entry_date") @db.Date
  description String?
  sourceType  String?        @map("source_type")
  sourceId    String?        @map("source_id") @db.Uuid
  postedAt    DateTime?      @map("posted_at") @db.Timestamptz(6)
  version     Int            @default(0)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
