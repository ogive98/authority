  pdfDocumentId        String?   @map("pdf_document_id") @db.Uuid
  currency             String    @default("TND")
  version              Int       @default(0)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(6)

  contract HrContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  employee HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  transferOrder HrTransferOrder?

  @@unique([companyId, periodYm, contractId])
  @@unique([companyId, number])
  @@index([companyId, periodYm])
  @@index([companyId, employeeId])
  @@map("hr_bulletin")
}

// --- hr_* Transfer order V0 (D222) — ADV confirm + PDF, amount = bulletin netPay ---

enum HrTransferOrderStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

/**
 * Ordre de virement salaire (D222).
 * Amount frozen from HrBulletin.netPay — never invented.
 * Confirm ADV creates FinApPayment BANK_TRANSFER for soft Banking match (no GL).
 */
model HrTransferOrder {
  id                       String                 @id @default(uuid()) @db.Uuid
  companyId                String                 @map("company_id") @db.Uuid
  number                   String
  bulletinId               String                 @map("bulletin_id") @db.Uuid
  employeeId               String                 @map("employee_id") @db.Uuid
  /** Company debit bank (FinBankAccount). */
  bankAccountId            String                 @map("bank_account_id") @db.Uuid
  amount                   Decimal                @db.Decimal(18, 3)
  currency                 String                 @default("TND")
  status                   HrTransferOrderStatus  @default(DRAFT)
  beneficiaryName          String                 @map("beneficiary_name")
  beneficiaryBankName      String?                @map("beneficiary_bank_name")
  beneficiaryBankAgency    String?                @map("beneficiary_bank_agency")
  beneficiaryBankAccount   String                 @map("beneficiary_bank_account")
  companyBankCode          String                 @map("company_bank_code")
  companyBankLabel         String                 @map("company_bank_label")
  companyBankRib           String?                @map("company_bank_rib")
  apPaymentId              String?                @map("ap_payment_id") @db.Uuid
  pdfDocumentId            String?                @map("pdf_document_id") @db.Uuid
  createdByUserId          String?                @map("created_by_user_id") @db.Uuid
  confirmedByUserId        String?                @map("confirmed_by_user_id") @db.Uuid
  confirmedAt              DateTime?              @map("confirmed_at") @db.Timestamptz(6)
  version                  Int                    @default(0)
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime?              @map("deleted_at") @db.Timestamptz(6)

  bulletin    HrBulletin      @relation(fields: [bulletinId], references: [id], onDelete: Cascade)
  employee    HrEmployee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  bankAccount FinBankAccount  @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  apPayment   FinApPayment?   @relation(fields: [apPaymentId], references: [id], onDelete: SetNull)

  @@unique([companyId, number])
  @@unique([bulletinId])
  @@index([companyId, status])
  @@index([companyId, employeeId])
  @@index([companyId, bankAccountId])
  @@index([companyId, apPaymentId])
  @@map("hr_transfer_order")
}

