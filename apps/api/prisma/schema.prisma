// ─── Repair / Thunder Control (D079) ─────────────────────────────────────────

enum RepScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
}

enum RepFindingSeverity {
  INFO
  WARN
  ERROR
  CRITICAL
}

enum RepFindingState {
  OPEN
  ACKED
  RESOLVED
  IGNORED
}

enum RepRiskLevel {
  NONE
  SAFE
  LOW
  MEDIUM
  HIGH
  BLOCKED
}

enum RepExecutionStatus {
  PLANNED
  DRY_RUN
  APPROVED
  RUNNING
  SUCCEEDED
  FAILED
  ROLLED_BACK
  BLOCKED
}

enum RepReportStatus {
  PENDING
  QUEUED
  SENT
  ACKED
  FAILED
}

model RepScanExecution {
  id           String        @id @default(uuid()) @db.Uuid
  companyId    String?       @map("company_id") @db.Uuid
  depth        String
  domainsJson  Json          @map("domains_json")
  status       RepScanStatus @default(PENDING)
  startedAt    DateTime?     @map("started_at") @db.Timestamptz(6)
  completedAt  DateTime?     @map("completed_at") @db.Timestamptz(6)
  findingCount Int           @default(0) @map("finding_count")
  errorCount   Int           @default(0) @map("error_count")
  summaryJson  Json?         @map("summary_json")
  createdBy    String?       @map("created_by") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  findings RepDiagnosticFinding[]

  @@index([companyId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("rep_scan_execution")
}

model RepDiagnosticFinding {
  id                  String             @id @default(uuid()) @db.Uuid
  companyId           String?            @map("company_id") @db.Uuid
  scanId              String             @map("scan_id") @db.Uuid
  component           String
  category            String
  severity            RepFindingSeverity @default(WARN)
  confidence          String             @default("PROBABLE")
  signatureId         String?            @map("signature_id")
  evidenceSummary     String             @map("evidence_summary")
  evidenceFingerprint String             @map("evidence_fingerprint")
  occurrenceCount     Int                @default(1) @map("occurrence_count")
  state               RepFindingState    @default(OPEN)
  repairability       String?            @default("unknown")
  recommendedJson     Json?              @map("recommended_json")
  risk                RepRiskLevel       @default(NONE)
  firstSeenAt         DateTime           @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt          DateTime           @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  scan        RepScanExecution     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  executions  RepRepairExecution[]

  @@index([scanId])
  @@index([companyId, state])
  @@index([evidenceFingerprint])
  @@map("rep_diagnostic_finding")
}

model RepDiagnosticIncident {
  id                 String             @id @default(uuid()) @db.Uuid
  companyId          String?            @map("company_id") @db.Uuid
  fingerprint        String
  status             RepFindingState    @default(OPEN)
  severity           RepFindingSeverity @default(WARN)
  signatureId        String?            @map("signature_id")
  title              String
  count              Int                @default(1)
  firstSeenAt        DateTime           @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt         DateTime           @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  centralIncidentId  String?            @map("central_incident_id")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, lastSeenAt(sort: Desc)])
  @@index([fingerprint])
  @@map("rep_diagnostic_incident")
}

model RepRepairExecution {
  id              String             @id @default(uuid()) @db.Uuid
  companyId       String?            @map("company_id") @db.Uuid
  findingId       String?            @map("finding_id") @db.Uuid
  scenarioId      String             @map("scenario_id")
  risk            RepRiskLevel
  status          RepExecutionStatus @default(PLANNED)
  dryRun          Boolean            @default(true) @map("dry_run")
  planJson        Json               @map("plan_json")
  resultJson      Json?              @map("result_json")
  snapshotRef     String?            @map("snapshot_ref")
  verificationJson Json?             @map("verification_json")
  rollbackJson    Json?              @map("rollback_json")
  approvedBy      String?            @map("approved_by") @db.Uuid
  executedBy      String?            @map("executed_by") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  finding RepDiagnosticFinding? @relation(fields: [findingId], references: [id])

  @@index([companyId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("rep_repair_execution")
}

model RepResetExecution {
  id          String             @id @default(uuid()) @db.Uuid
  companyId   String?            @map("company_id") @db.Uuid
  scope       String
  previewJson Json               @map("preview_json")
  status      RepExecutionStatus @default(PLANNED)
  dryRun      Boolean            @default(true) @map("dry_run")
  resultJson  Json?              @map("result_json")
  createdBy   String?            @map("created_by") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([companyId, createdAt(sort: Desc)])
  @@map("rep_reset_execution")
}

model RepCentralReport {
  id              String          @id @default(uuid()) @db.Uuid
  companyId       String?         @map("company_id") @db.Uuid
  reportType      String          @map("report_type")
  fingerprint     String
  schemaVersion   Int             @default(1) @map("schema_version")
  payloadJson     Json            @map("payload_json")
  status          RepReportStatus @default(PENDING)
  attempts        Int             @default(0)
  centralId       String?         @map("central_id")
  lastError       String?         @map("last_error")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  outbox RepDiagnosticOutbox?

  @@index([status, createdAt])
  @@index([fingerprint])
  @@map("rep_central_report")
}

model RepDiagnosticOutbox {
  id            String          @id @default(uuid()) @db.Uuid
  reportId      String          @unique @map("report_id") @db.Uuid
  state         RepReportStatus @default(QUEUED)
  nextAttemptAt DateTime        @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  attempts      Int             @default(0)
  lastError     String?         @map("last_error")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  report RepCentralReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([state, nextAttemptAt])
  @@map("rep_diagnostic_outbox")
}

// --- prd_* Production light (MOD-PRODUCTION) ---
// Note: product catalog already uses PrdProduct / prd_product; WO tables share prd_ prefix per module docs.

enum ProdWoStatus {
  PLANNED
  RELEASED
  IN_PROGRESS
  DONE
  CANCELLED
}

model ProdWorkOrder {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  number      String
  productId   String       @map("product_id") @db.Uuid
  warehouseId String       @map("warehouse_id") @db.Uuid
  plannedQty  Decimal      @map("planned_qty") @db.Decimal(18, 3)
  actualQty   Decimal?     @map("actual_qty") @db.Decimal(18, 3)
  lotOut      String?      @map("lot_out")
  status      ProdWoStatus @default(PLANNED)
  notes       String?
  version     Int          @default(0)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz(6)

  consumptions ProdWoConsumption[]
  outputs      ProdWoOutput[]
  scraps       ProdScrap[]

  @@unique([companyId, number])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, status])
  @@map("prd_wo")
}

model ProdWoConsumption {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  workOrderId String   @map("work_order_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  qty         Decimal  @db.Decimal(18, 3)
  lotIn       String?  @map("lot_in")
  postedAt    DateTime @default(now()) @map("posted_at") @db.Timestamptz(6)

  workOrder ProdWorkOrder @relation(fields: [workOrderId], references: [id])

  @@index([companyId, workOrderId])
  @@map("prd_wo_cons")
}

model ProdWoOutput {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  workOrderId String   @map("work_order_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  qty         Decimal  @db.Decimal(18, 3)
  lotOut      String?  @map("lot_out")
  postedAt    DateTime @default(now()) @map("posted_at") @db.Timestamptz(6)

  workOrder ProdWorkOrder @relation(fields: [workOrderId], references: [id])

  @@index([companyId, workOrderId])
  @@map("prd_wo_out")
}

model ProdScrap {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  workOrderId String   @map("work_order_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  qty         Decimal  @db.Decimal(18, 3)
  reason      String?
  postedAt    DateTime @default(now()) @map("posted_at") @db.Timestamptz(6)

  workOrder ProdWorkOrder @relation(fields: [workOrderId], references: [id])

  @@index([companyId, workOrderId])
  @@map("prd_scrap")
}

// --- hr_* HR light V0 (D089) — employees/contracts; no CNSS/IRPP rates (Payroll later) ---

enum HrEmployeeStatus {
  ACTIVE
  LEFT
}

enum HrContractStatus {
  ACTIVE
  ENDED
}

enum HrContractType {
  CDI
  CDD
  INTERIM
  STAGE
  OTHER
}

model HrJobTitle {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  code      String
  name      String
  active    Boolean   @default(true)
  version   Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  employees HrEmployee[]

  @@unique([companyId, code])
  @@index([companyId, active])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("hr_job_title")
}

model HrEmployee {
  id          String           @id @default(uuid()) @db.Uuid
  companyId   String           @map("company_id") @db.Uuid
  matricule   String
  displayName String           @map("display_name")
  siteId      String?          @map("site_id") @db.Uuid
  department  String?
  jobTitleId  String?          @map("job_title_id") @db.Uuid
  /** CNSS affiliation number — identifier only, never a contribution rate. */
  cnssNo      String?          @map("cnss_no")
  email       String?
  userId      String?          @map("user_id") @db.Uuid
  status      HrEmployeeStatus @default(ACTIVE)
  hiredAt     DateTime?        @map("hired_at") @db.Date
  leftAt      DateTime?        @map("left_at") @db.Date
  notes       String?
  /** Tax family status — null until human sets (D202 gate 5B). */
  taxChefDeFamille Boolean?    @map("tax_chef_de_famille")
  /** Dependent children count — null until human sets. */
  taxEnfantCount   Int?        @map("tax_enfant_count")
  /** Portrait — Documents HR_EMPLOYEE image (D211). */
  photoDocumentId  String?     @map("photo_document_id") @db.Uuid
  version     Int              @default(0)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?        @map("deleted_at") @db.Timestamptz(6)

  jobTitle      HrJobTitle?      @relation(fields: [jobTitleId], references: [id], onDelete: SetNull)
  photoDocument DocDocument?     @relation(fields: [photoDocumentId], references: [id], onDelete: SetNull)
  contracts     HrContract[]
  cnssSnapshots HrCnssSnapshot[]
  irppSnapshots HrIrppSnapshot[]
  bulletins     HrBulletin[]

  @@unique([companyId, matricule])
  @@index([companyId, status])
  @@index([companyId, jobTitleId])
  @@index([companyId, photoDocumentId])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("hr_employee")
}

model HrContract {
  id         String           @id @default(uuid()) @db.Uuid
  companyId  String           @map("company_id") @db.Uuid
  employeeId String           @map("employee_id") @db.Uuid
  number     String
  type       HrContractType   @default(CDI)
  status     HrContractStatus @default(ACTIVE)
  startDate  DateTime         @map("start_date") @db.Date
  endDate    DateTime?        @map("end_date") @db.Date
  /** Wage reference label only — no invented payroll rates. */
  wageRef    String?          @map("wage_ref")
  /** Human numeric wage base TND for CNSS preview/snapshot (D195) — not a rate. */
  wageBase   Decimal?         @map("wage_base") @db.Decimal(18, 3)
  notes      String?
  version    Int              @default(0)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime?        @map("deleted_at") @db.Timestamptz(6)

  employee      HrEmployee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cnssSnapshots HrCnssSnapshot[]
  irppSnapshots HrIrppSnapshot[]
  bulletins     HrBulletin[]

  @@unique([companyId, number])
  @@index([companyId, employeeId])
  @@index([companyId, status])
  @@map("hr_contract")
}

/**
 * Annual IRPP brackets (D196) — human-entered only, never seeded.
 * Consumed only when Prefs slot `hr.irpp` is VALIDATED.
 */
model HrIrppBracket {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  sortOrder  Int       @map("sort_order")
  /** Annual upper bound in millimes; null = open-ended band. */
  upToMilli  Int?      @map("up_to_milli")
  rateBps    Int       @map("rate_bps")
  lawRef     String?   @map("law_ref")
  version    Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([companyId, sortOrder])
  @@map("hr_irpp_bracket")
}

/**
 * Period CNSS snapshot (D195) — amounts from VALIDATED Prefs rates only.
 * Never stores invented barèmes.
 */
model HrCnssSnapshot {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  /** YYYY-MM */
  periodYm         String    @map("period_ym")
  employeeId       String    @map("employee_id") @db.Uuid
  contractId       String    @map("contract_id") @db.Uuid
  wageBase         Decimal   @map("wage_base") @db.Decimal(18, 3)
  assiette         Decimal   @db.Decimal(18, 3)
  ceilingApplied   Boolean   @default(false) @map("ceiling_applied")
  ceilingAmount    Decimal?  @map("ceiling_amount") @db.Decimal(18, 3)
  employeeRateBps  Int?      @map("employee_rate_bps")
  employerRateBps  Int?      @map("employer_rate_bps")
  employeeAmount   Decimal?  @map("employee_amount") @db.Decimal(18, 3)
  employerAmount   Decimal?  @map("employer_amount") @db.Decimal(18, 3)
  employeeLawRef   String?   @map("employee_law_ref")
  employerLawRef   String?   @map("employer_law_ref")
  ceilingLawRef    String?   @map("ceiling_law_ref")
  currency         String    @default("TND")
  version          Int       @default(0)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  contract HrContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  employee HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([companyId, periodYm, contractId])
  @@index([companyId, periodYm])
  @@index([companyId, employeeId])
  @@map("hr_cnss_snapshot")
}

/**
 * Period IRPP snapshot (D196/D202) — progressive annual brackets / 12.
 * Assiette = wageBase − CNSS salarié − abattements annuels (Prefs VALIDATED); never invents.
 */
model HrIrppSnapshot {
  id                 String    @id @default(uuid()) @db.Uuid
  companyId          String    @map("company_id") @db.Uuid
  /** YYYY-MM */
  periodYm           String    @map("period_ym")
  employeeId         String    @map("employee_id") @db.Uuid
  contractId         String    @map("contract_id") @db.Uuid
  wageBase           Decimal   @map("wage_base") @db.Decimal(18, 3)
  cnssEmployeeAmount Decimal   @map("cnss_employee_amount") @db.Decimal(18, 3)
  taxableMonthly     Decimal   @map("taxable_monthly") @db.Decimal(18, 3)
  /** Annual taxable before family abatements (D202). */
  annualTaxableBeforeAbat Decimal @map("annual_taxable_before_abat") @db.Decimal(18, 3)
  /** Annual taxable after abatements — input to progressive brackets. */
  annualTaxable      Decimal   @map("annual_taxable") @db.Decimal(18, 3)
  annualIrpp         Decimal   @map("annual_irpp") @db.Decimal(18, 3)
  monthlyIrpp        Decimal   @map("monthly_irpp") @db.Decimal(18, 3)
  /** Frozen employee tax status at snapshot (D202). */
  taxChefDeFamille   Boolean?  @map("tax_chef_de_famille")
  taxEnfantCount     Int?      @map("tax_enfant_count")
  abatChefAnnual     Decimal   @default(0) @map("abat_chef_annual") @db.Decimal(18, 3)
  abatEnfantAnnual   Decimal   @default(0) @map("abat_enfant_annual") @db.Decimal(18, 3)
  abatTotalAnnual    Decimal   @default(0) @map("abat_total_annual") @db.Decimal(18, 3)
  abatChefLawRef     String?   @map("abat_chef_law_ref")
  abatEnfantLawRef   String?   @map("abat_enfant_law_ref")
  /** Frozen annual brackets used at snapshot time. */
  bracketsJson       Json      @map("brackets_json")
  irppLawRef         String?   @map("irpp_law_ref")
  methodNote         String    @default("annual_brackets_div_12") @map("method_note")
  currency           String    @default("TND")
  version            Int       @default(0)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  contract HrContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  employee HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([companyId, periodYm, contractId])
  @@index([companyId, periodYm])
  @@index([companyId, employeeId])
  @@map("hr_irpp_snapshot")
}

/**
 * Period payslip compose (D199) — freezes CNSS+IRPP snapshot amounts.
 * No invented rates; both snapshots required.
 */
model HrBulletin {
  id                   String    @id @default(uuid()) @db.Uuid
  companyId            String    @map("company_id") @db.Uuid
  /** YYYY-MM */
  periodYm             String    @map("period_ym")
  employeeId           String    @map("employee_id") @db.Uuid
  contractId           String    @map("contract_id") @db.Uuid
  number               String
  wageBase             Decimal   @map("wage_base") @db.Decimal(18, 3)
  cnssEmployeeAmount   Decimal   @map("cnss_employee_amount") @db.Decimal(18, 3)
  cnssEmployerAmount   Decimal   @map("cnss_employer_amount") @db.Decimal(18, 3)
  irppMonthly          Decimal   @map("irpp_monthly") @db.Decimal(18, 3)
  /** wageBase − CNSS salarié − IRPP mensuel (display net V0). */
  netPay               Decimal   @map("net_pay") @db.Decimal(18, 3)
  cnssSnapshotId       String?   @map("cnss_snapshot_id") @db.Uuid
  irppSnapshotId       String?   @map("irpp_snapshot_id") @db.Uuid
  /** Latest persisted PDF document (D202 Documents link HR_BULLETIN). */
  pdfDocumentId        String?   @map("pdf_document_id") @db.Uuid
  currency             String    @default("TND")
  version              Int       @default(0)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(6)

  contract HrContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  employee HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([companyId, periodYm, contractId])
  @@unique([companyId, number])
  @@index([companyId, periodYm])
  @@index([companyId, employeeId])
  @@map("hr_bulletin")
}
