/** Lot / batch V0 — DLC optional; FEFO consume via InvLotAllocation (D097). */
model InvLot {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  warehouseId String       @map("warehouse_id") @db.Uuid
